# ─────────────────────────────────────────────────────────────
# Rydo Backend — Environment Variables
# Copy to .env and fill in values
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ── Vercel Postgres (Neon) ────────────────────────────────────
# These are auto-injected by Vercel when you connect a Postgres database.
# For local development, use either POSTGRES_URL or the individual vars below.
#
# POSTGRES_URL=postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/rydo_db?sslmode=require
# POSTGRES_URL_NON_POOLING=postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/rydo_db?sslmode=require
# POSTGRES_HOST=ep-xxx.us-east-1.aws.neon.tech
# POSTGRES_USER=your_neon_user
# POSTGRES_PASSWORD=your_neon_password
# POSTGRES_DATABASE=rydo_db

# ── Local Docker Postgres (fallback for local dev) ───────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rydo_user
DB_PASSWORD=rydo_password
DB_NAME=rydo_db

# ── Vercel KV / Upstash Redis ─────────────────────────────────
# These are auto-injected by Vercel when you connect an Upstash Redis store.
#
# KV_URL=redis://default:xxx@yyy.upstash.io:6379
# KV_REST_API_URL=https://yyy.upstash.io
# KV_REST_API_TOKEN=xxx

# ── Local Redis (fallback for local dev) ─────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Firebase (Push Notifications) ────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── SMS (Twilio) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
