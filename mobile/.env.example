# Copy this to google-services.json (Android) and GoogleService-Info.plist (iOS)
# from your Firebase Console

# Firebase project: https://console.firebase.google.com
# 1. Create project "rydo-app"
# 2. Add Android app: com.rydo.app
# 3. Add iOS app: com.rydo.app
# 4. Download config files and place in:
#    Android: android/app/google-services.json
#    iOS: ios/Runner/GoogleService-Info.plist

# Google Maps API Key
# Add to: android/app/src/main/AndroidManifest.xml
# <meta-data android:name="com.google.android.geo.API_KEY" android:value="YOUR_KEY"/>
#
# And to: ios/Runner/AppDelegate.swift
# GMSServices.provideAPIKey("YOUR_KEY")

GOOGLE_MAPS_API_KEY=your_google_maps_api_key
API_BASE_URL=http://10.0.2.2:4000/api
