# ─────────────────────────────────────────────────────────────
# Rydo Frontend — Environment Variables
# These are auto-injected by Vercel when deploying.
# For local dev, copy to .env.local and fill in values.
# ─────────────────────────────────────────────────────────────

# Backend API URL (Vercel backend deployment URL)
NEXT_PUBLIC_API_URL=https://rydo-backend.vercel.app

# Socket.IO URL (same as API URL)
NEXT_PUBLIC_SOCKET_URL=https://rydo-backend.vercel.app

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Vercel Postgres — auto-injected by Vercel (do not set manually)
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
